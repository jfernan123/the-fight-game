# --- Training output ---------------------------------------------------------------------------
# Checkpoints and TensorBoard logs. These are large (runs_gpu/ alone is ~170MB here, archive/runs/
# another ~139MB) and are regenerated by any training run, so they don't belong in the repo.
# Each training launch writes into its own timestamped subfolder, so these grow without bound.
runs/
runs_gpu/
tb_logs/
tb_logs_gpu/

# Model weights anywhere else they land. GitHub rejects files over 100MB and warns above 50MB, so
# if you ever DO want to keep one specific checkpoint, force it in deliberately:
#     git add -f runs_gpu/single/<run-id>/walker_final.pt
*.pt
*.zip

# --- Python ------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ----------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Editor / tooling --------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local state (machine-specific settings and lock files, not project config)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- OS ----------------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Misc --------------------------------------------------------------------------------------
*.log
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# MuJoCo / Warp kernel cache, if it ever lands in-tree
*.mjb
warp_cache/
